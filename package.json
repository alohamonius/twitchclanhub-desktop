{
  "name": "twitchclanhub-desktop",
  "version": "0.6.0",
  "private": true,
  "description": "Tray app: draws the channel's alerts over the streamer's own screen",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test \"test/*.test.js\"",
    "dist:win": "electron-builder --win nsis --publish never",
    "dist:mac": "electron-builder --mac dmg --universal --publish never"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "com.twitchclanhub.desktop",
    "productName": "twitchclanhub",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "flow.js",
      "log.js",
      "overlay.js",
      "updater.js",
      "assets/**"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "deleteAppDataOnUninstall": false,
      "artifactName": "twitchclanhub-setup.exe"
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.utilities",
      "icon": "assets/icon.png",
      "identity": null,
      "artifactName": "twitchclanhub-mac.${ext}"
    },
    "dmg": {
      "title": "twitchclanhub"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "alohamonius",
        "repo": "twitchclanhub-desktop"
      }
    ]
  },
  "license": "MIT",
  "dependencies": {
    "electron-updater": "6.3.9"
  }
}
